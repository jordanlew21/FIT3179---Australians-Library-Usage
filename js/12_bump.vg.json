{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "Which states lean most on digital, ranked",
  "subtitle": "Rank by digital share of library use (1 is highest)"
 },
 "width": "container",
 "height": 340,
 "data": {
  "url": "data/digital_rank.csv"
 },
 "transform": [
  {
   "window": [
    {
     "op": "rank",
     "as": "rk"
    }
   ],
   "groupby": [
    "year"
   ],
   "sort": [
    {
     "field": "share",
     "order": "descending"
    }
   ]
  }
 ],
 "encoding": {
  "x": {
   "field": "year",
   "type": "ordinal",
   "title": null,
   "scale": {
    "padding": 0.7
   },
   "axis": {
    "labelAngle": 0,
    "labelFontSize": 13
   }
  },
  "y": {
   "field": "rk",
   "type": "quantitative",
   "title": "Rank",
   "scale": {
    "reverse": true,
    "domain": [
     0.6,
     8.4
    ]
   },
   "axis": {
    "values": [
     1,
     2,
     3,
     4,
     5,
     6,
     7,
     8
    ],
    "grid": false
   }
  },
  "color": {
   "field": "state",
   "type": "nominal",
   "legend": null,
   "scale": {
    "scheme": "category10"
   }
  }
 },
 "layer": [
  {
   "mark": {
    "type": "line",
    "strokeWidth": 3
   },
   "encoding": {
    "detail": {
     "field": "state"
    }
   }
  },
  {
   "mark": {
    "type": "circle",
    "size": 150
   },
   "encoding": {
    "tooltip": [
     {
      "field": "state"
     },
     {
      "field": "year"
     },
     {
      "field": "share",
      "title": "Digital share",
      "format": ".1%"
     },
     {
      "field": "rk",
      "title": "Rank"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "filter": "datum.year == '2024-25'"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "dx": 12,
    "fontWeight": "bold",
    "fontSize": 12
   },
   "encoding": {
    "text": {
     "field": "state"
    }
   }
  },
  {
   "transform": [
    {
     "filter": "datum.year == '2021-22'"
    }
   ],
   "mark": {
    "type": "text",
    "align": "right",
    "dx": -12,
    "fontWeight": "bold",
    "fontSize": 12
   },
   "encoding": {
    "text": {
     "field": "state"
    }
   }
  }
 ],
 "config": {
  "font": "Open Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Lora",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "Open Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "Open Sans"
  }
 }
}