{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "How often adult library visitors go",
  "subtitle": "Share of library visitors, by visits in a year"
 },
 "width": "container",
 "height": 150,
 "data": {
  "url": "data/abs_library_attendance.csv"
 },
 "transform": [
  {
   "filter": "datum.breakdown == 'Visits per year (attendees)' && datum.population == 'Adults (15+)'"
  }
 ],
 "mark": {
  "type": "bar",
  "stroke": "white"
 },
 "encoding": {
  "y": {
   "field": "year",
   "type": "nominal",
   "title": null,
   "axis": {
    "labelFontSize": 13
   }
  },
  "x": {
   "field": "percent",
   "type": "quantitative",
   "stack": "normalize",
   "title": null,
   "axis": {
    "format": "%"
   }
  },
  "color": {
   "field": "group",
   "type": "nominal",
   "title": "Visits a year",
   "sort": [
    "Once",
    "2-10 times",
    "11 or more times"
   ],
   "scale": {
    "domain": [
     "Once",
     "2-10 times",
     "11 or more times"
    ],
    "range": [
     "#f1e4f3",
     "#c58fd0",
     "#7a2f8e"
    ]
   },
   "legend": {
    "orient": "top"
   }
  },
  "tooltip": [
   {
    "field": "group",
    "title": "Visits"
   },
   {
    "field": "percent",
    "title": "%"
   },
   {
    "field": "year"
   }
  ]
 },
 "config": {
  "font": "DM Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Playfair Display",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "DM Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "DM Sans",
   "titleFont": "DM Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "DM Sans",
   "titleFont": "DM Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "DM Sans"
  }
 }
}
