{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "Library branches per state, 2024-25",
  "subtitle": "Circle area = branches, placed on each capital"
 },
 "width": "container",
 "height": 430,
 "projection": {
  "type": "conicEqualArea",
  "parallels": [
   -18,
   -36
  ],
  "rotate": [
   -132,
   0
  ]
 },
 "layer": [
  {
   "data": {
    "url": "data/australia_states.topojson",
    "format": {
     "type": "topojson",
     "feature": "australia_states"
    }
   },
   "mark": {
    "type": "geoshape",
    "fill": "#e4e0d8",
    "stroke": "white"
   }
  },
  {
   "data": {
    "url": "data/states.csv"
   },
   "mark": {
    "type": "circle",
    "opacity": 0.78,
    "stroke": "white",
    "strokeWidth": 1.5,
    "color": "#4a6072"
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "size": {
     "field": "branches",
     "type": "quantitative",
     "title": "Branches",
     "scale": {
      "type": "linear",
      "domain": [
       0,
       400
      ],
      "range": [
       0,
       2600
      ],
      "zero": true
     },
     "legend": {
      "values": [
       10,
       100,
       300
      ],
      "orient": "top-right",
      "title": "Branches"
     }
    },
    "tooltip": [
     {
      "field": "state_name",
      "title": "State"
     },
     {
      "field": "branches",
      "title": "Branches"
     }
    ]
   }
  },
  {
   "data": {
    "values": [
     {
      "lon": 149.13,
      "lat": -35.28,
      "lon2": 150.9,
      "lat2": -37.6
     }
    ]
   },
   "mark": {
    "type": "rule",
    "color": "#555",
    "strokeWidth": 1
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "longitude2": {
     "field": "lon2"
    },
    "latitude2": {
     "field": "lat2"
    }
   }
  },
  {
   "data": {
    "url": "data/states.csv"
   },
   "transform": [
    {
     "filter": "datum.state != 'ACT'"
    },
    {
     "calculate": "datum.state == 'VIC' ? 142.6 : datum.state == 'TAS' ? 146.3 : datum.label_lon",
     "as": "llon"
    },
    {
     "calculate": "datum.state == 'VIC' ? -35.2 : datum.state == 'TAS' ? -41.4 : datum.label_lat",
     "as": "llat"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 12,
    "fontWeight": "bold",
    "color": "#333"
   },
   "encoding": {
    "longitude": {
     "field": "llon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "llat",
     "type": "quantitative"
    },
    "text": {
     "field": "state",
     "type": "nominal"
    }
   }
  },
  {
   "data": {
    "values": [
     {
      "lon": 150.9,
      "lat": -37.6,
      "tag": "ACT"
     }
    ]
   },
   "mark": {
    "type": "text",
    "fontSize": 12,
    "fontWeight": "bold",
    "color": "#333",
    "align": "left",
    "dx": 4,
    "dy": 6
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "text": {
     "field": "tag",
     "type": "nominal"
    }
   }
  }
 ],
 "config": {
  "font": "DM Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Playfair Display",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "DM Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "DM Sans",
   "titleFont": "DM Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "DM Sans",
   "titleFont": "DM Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "DM Sans"
  }
 }
}
