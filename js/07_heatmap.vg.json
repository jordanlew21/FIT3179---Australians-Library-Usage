{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "How each state changed between 2021-22 and 2024-25",
  "subtitle": "Blue = decrease, orange = increase; colours stop at -50% and +100%"
 },
 "width": "container",
 "height": 330,
 "data": {
  "url": "data/state_change.csv"
 },
 "encoding": {
  "x": {
   "field": "measure",
   "type": "nominal",
   "title": null,
   "sort": [
    "Physical visits",
    "Website visits",
    "Digital use",
    "Program participants",
    "Opening hours"
   ],
   "axis": {
    "orient": "top",
    "labelAngle": 0,
    "labelLimit": 220
   }
  },
  "y": {
   "field": "state",
   "type": "nominal",
   "title": null,
   "sort": [
    "NSW",
    "VIC",
    "QLD",
    "SA",
    "WA",
    "TAS",
    "NT",
    "ACT"
   ]
  }
 },
 "layer": [
  {
   "mark": "rect",
   "encoding": {
    "color": {
     "field": "change",
     "type": "quantitative",
     "title": "Change since 2021-22",
     "scale": {
      "type": "linear",
      "clamp": true,
      "domain": [
       -0.5,
       -0.2,
       0,
       0.2,
       0.5,
       1.0
      ],
      "range": [
       "#3a7ca5",
       "#9cc3dd",
       "#f1efe9",
       "#fbd5a8",
       "#f0985a",
       "#c24e17"
      ]
     },
     "legend": {
      "type": "gradient",
      "orient": "right",
      "gradientLength": 240,
      "gradientThickness": 16,
      "values": [
       -0.5,
       -0.2,
       0,
       0.2,
       0.5,
       1.0
      ],
      "labelExpr": "datum.value >= 1 ? '+100% or more' : datum.value <= -0.5 ? '-50% or less' : format(datum.value, '+.0%')"
     }
    },
    "tooltip": [
     {
      "field": "state"
     },
     {
      "field": "measure"
     },
     {
      "field": "change",
      "format": "+.0%",
      "title": "Change"
     }
    ]
   }
  },
  {
   "mark": {
    "type": "text",
    "fontSize": 12
   },
   "encoding": {
    "text": {
     "field": "change",
     "type": "quantitative",
     "format": "+.0%"
    },
    "color": {
     "condition": {
      "test": "datum.change <= -0.4 || datum.change >= 0.8",
      "value": "white"
     },
     "value": "#222"
    }
   }
  }
 ],
 "config": {
  "font": "Open Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Lora",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "Open Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "Open Sans"
  }
 }
}
