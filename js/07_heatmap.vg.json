{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "How each state changed between 2021-22 and 2024-25",
  "subtitle": "Blue = decrease, orange = increase; the darkest orange is +100% or more"
 },
 "width": "container",
 "height": 330,
 "data": {
  "url": "data/state_change.csv"
 },
 "transform": [
  {
   "calculate": "datum.change < -0.5 ? 'Below -50%' : datum.change < -0.2 ? '-50% to -20%' : datum.change < -0.05 ? '-20% to -5%' : datum.change < 0.05 ? '-5% to +5%' : datum.change < 0.2 ? '+5% to +20%' : datum.change < 0.5 ? '+20% to +50%' : datum.change < 1.0 ? '+50% to +100%' : '+100% or more'",
   "as": "band"
  }
 ],
 "encoding": {
  "x": {
   "field": "measure",
   "type": "nominal",
   "title": null,
   "sort": [
    "Physical visits",
    "Website visits",
    "Digital use",
    "Program participants",
    "Opening hours"
   ],
   "axis": {
    "orient": "top",
    "labelAngle": 0,
    "labelLimit": 220
   }
  },
  "y": {
   "field": "state",
   "type": "nominal",
   "title": null,
   "sort": [
    "NSW",
    "VIC",
    "QLD",
    "SA",
    "WA",
    "TAS",
    "NT",
    "ACT"
   ]
  }
 },
 "layer": [
  {
   "mark": "rect",
   "encoding": {
    "color": {
     "field": "band",
     "type": "ordinal",
     "title": "Change since 2021-22",
     "scale": {
      "domain": [
       "Below -50%",
       "-50% to -20%",
       "-20% to -5%",
       "-5% to +5%",
       "+5% to +20%",
       "+20% to +50%",
       "+50% to +100%",
       "+100% or more"
      ],
      "range": [
       "#3a7ca5",
       "#7fb2d3",
       "#c1dcec",
       "#f1efe9",
       "#fde0bd",
       "#f7b26b",
       "#e8803a",
       "#c24e17"
      ]
     },
     "legend": {
      "type": "symbol",
      "symbolType": "square",
      "symbolSize": 260,
      "orient": "right",
      "rowPadding": 4
     }
    },
    "tooltip": [
     {
      "field": "state"
     },
     {
      "field": "measure"
     },
     {
      "field": "change",
      "format": "+.0%",
      "title": "Change"
     }
    ]
   }
  },
  {
   "mark": {
    "type": "text",
    "fontSize": 12
   },
   "encoding": {
    "text": {
     "field": "change",
     "type": "quantitative",
     "format": "+.0%"
    },
    "color": {
     "condition": {
      "test": "datum.change < -0.5 || datum.change >= 1.0",
      "value": "white"
     },
     "value": "#222"
    }
   }
  }
 ],
 "config": {
  "font": "Open Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Lora",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "Open Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "Open Sans"
  }
 }
}
