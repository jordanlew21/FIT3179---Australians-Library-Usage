{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "How each state changed between 2021-22 and 2024-25",
  "subtitle": "Change from 2021-22; darkest orange means over +100%"
 },
 "width": "container",
 "height": 330,
 "data": {
  "url": "data/state_change.csv"
 },
 "encoding": {
  "x": {
   "field": "measure",
   "type": "nominal",
   "title": null,
   "sort": [
    "Physical visits",
    "Website visits",
    "Digital use",
    "Program participants",
    "Opening hours"
   ],
   "axis": {
    "orient": "top",
    "labelAngle": 0,
    "labelLimit": 220
   }
  },
  "y": {
   "field": "state",
   "type": "nominal",
   "title": null,
   "sort": [
    "NSW",
    "VIC",
    "QLD",
    "SA",
    "WA",
    "TAS",
    "NT",
    "ACT"
   ]
  }
 },
 "layer": [
  {
   "mark": "rect",
   "encoding": {
    "color": {
     "field": "change",
     "type": "quantitative",
     "title": "Change",
     "scale": {
      "type": "threshold",
      "domain": [
       -0.5,
       -0.2,
       -0.05,
       0.05,
       0.2,
       0.5,
       1.0
      ],
      "range": [
       "#2c5f8a",
       "#6a9fc7",
       "#bcd6ea",
       "#f1efe9",
       "#fbd5a8",
       "#f5a65b",
       "#e0742a",
       "#8f3d0c"
      ]
     },
     "legend": {
      "title": "Change",
      "format": ".0%",
      "symbolType": "square",
      "orient": "right"
     }
    },
    "tooltip": [
     {
      "field": "state"
     },
     {
      "field": "measure"
     },
     {
      "field": "change",
      "format": ".0%"
     }
    ]
   }
  },
  {
   "mark": {
    "type": "text",
    "fontSize": 12
   },
   "encoding": {
    "text": {
     "field": "change",
     "type": "quantitative",
     "format": "+.0%"
    },
    "color": {
     "condition": {
      "test": "datum.change < -0.2 || datum.change > 0.5",
      "value": "white"
     },
     "value": "#222"
    }
   }
  }
 ],
 "config": {
  "font": "Open Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Lora",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "Open Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "Open Sans"
  }
 }
}
