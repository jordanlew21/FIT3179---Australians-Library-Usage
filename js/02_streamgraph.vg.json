{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "Physical and digital library use, 2021-22 to 2024-25",
  "subtitle": "Millions of loans, downloads, streams and database sessions"
 },
 "width": "container",
 "height": 300,
 "data": {
  "url": "data/national_5yr_trend.csv"
 },
 "transform": [
  {
   "filter": "(datum.measure == 'Physical collection usage' || datum.measure == 'Digital collection usage (loans, database use, streaming)') && datum.year != '2020-21'"
  },
  {
   "calculate": "toNumber(slice(datum.year, 0, 4))",
   "as": "yr"
  },
  {
   "calculate": "indexof(datum.measure, 'Physical') == 0 ? 'Physical' : 'Digital'",
   "as": "kind"
  }
 ],
 "layer": [
  {
   "mark": {
    "type": "area",
    "interpolate": "monotone",
    "opacity": 0.9
   },
   "encoding": {
    "x": {
     "field": "yr",
     "type": "quantitative",
     "title": null,
     "axis": {
      "values": [
       2021,
       2022,
       2023,
       2024
      ],
      "format": "d",
      "labelExpr": "datum.value + '-' + slice(toString(datum.value + 1), 2)",
      "grid": false
     }
    },
    "y": {
     "field": "value",
     "type": "quantitative",
     "stack": "center",
     "axis": null
    },
    "color": {
     "field": "kind",
     "type": "nominal",
     "title": null,
     "scale": {
      "domain": [
       "Physical",
       "Digital"
      ],
      "range": [
       "#8c6d46",
       "#1f7a8c"
      ]
     },
     "legend": {
      "orient": "top"
     }
    },
    "tooltip": [
     {
      "field": "kind",
      "title": "Type"
     },
     {
      "field": "year",
      "title": "Year"
     },
     {
      "field": "value",
      "title": "Loans",
      "format": ","
     }
    ]
   }
  },
  {
   "data": {
    "values": [
     {
      "x": 2021.04,
      "t": "Digital use grew from 43m to 61m"
     }
    ]
   },
   "mark": {
    "type": "text",
    "align": "left",
    "fontSize": 13,
    "fontWeight": "bold",
    "color": "#1f7a8c"
   },
   "encoding": {
    "x": {
     "field": "x",
     "type": "quantitative"
    },
    "y": {
     "value": 16
    },
    "text": {
     "field": "t"
    }
   }
  }
 ],
 "config": {
  "font": "Open Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Lora",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "Open Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "Open Sans"
  }
 }
}