{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "Venues adults visited, 2017-18 and 2021-22.",
  "subtitle": "Percent of adults; labels show relative change"
 },
 "width": "container",
 "height": 330,
 "data": {
  "url": "data/abs_library_attendance.csv"
 },
 "transform": [
  {
   "filter": "datum.breakdown == 'Venue' && datum.population == 'Adults (15+)'"
  },
  {
   "pivot": "year",
   "value": "percent",
   "groupby": [
    "venue_or_activity"
   ]
  },
  {
   "calculate": "datum['2017-18']",
   "as": "a"
  },
  {
   "calculate": "datum['2021-22']",
   "as": "b"
  },
  {
   "calculate": "datum.b / datum.a - 1",
   "as": "rel"
  }
 ],
 "encoding": {
  "y": {
   "field": "venue_or_activity",
   "type": "nominal",
   "title": null,
   "sort": {
    "op": "max",
    "field": "rel",
    "order": "descending"
   },
   "axis": {
    "labelLimit": 280
   }
  }
 },
 "layer": [
  {
   "mark": {
    "type": "rule",
    "strokeWidth": 3,
    "color": "#cfcfcf"
   },
   "encoding": {
    "x": {
     "field": "a",
     "type": "quantitative",
     "title": "Percent of adults who attended",
     "scale": {
      "domain": [
       0,
       80
      ]
     }
    },
    "x2": {
     "field": "b"
    }
   }
  },
  {
   "transform": [
    {
     "fold": [
      "a",
      "b"
     ],
     "as": [
      "period",
      "attendance"
     ]
    },
    {
     "calculate": "datum.period == 'a' ? 'Before (2017-18)' : 'After (2021-22)'",
     "as": "period_label"
    }
   ],
   "mark": {
    "type": "point",
    "filled": true,
    "size": 110
   },
   "encoding": {
    "x": {
     "field": "attendance",
     "type": "quantitative"
    },
    "color": {
     "field": "period_label",
     "type": "nominal",
     "scale": {
      "domain": [
       "Before (2017-18)",
       "After (2021-22)"
      ],
      "range": [
       "#999999",
       "#d97b2c"
      ]
     },
     "legend": {
      "title": "Period",
      "orient": "top"
     }
    },
    "shape": {
     "condition": {
      "test": "datum.venue_or_activity == 'Libraries'",
      "value": "diamond"
     },
     "value": "circle",
     "legend": null
    },
    "tooltip": [
     {
      "field": "venue_or_activity",
      "title": "Venue"
     },
     {
      "field": "period_label",
      "title": "Period"
     },
     {
      "field": "attendance",
      "title": "Attendance (%)",
      "format": ".1f"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "filter": "datum.venue_or_activity == 'Libraries'"
    },
    {
     "calculate": "'Libraries'",
     "as": "highlight"
    }
   ],
   "mark": {
    "type": "point",
    "filled": true,
    "size": 180,
    "color": "#1f7a8c",
    "shape": "diamond",
    "stroke": "#ffffff",
    "strokeWidth": 1.5
   },
   "encoding": {
    "x": {
     "field": "b",
     "type": "quantitative"
    },
    "tooltip": [
     {
      "field": "venue_or_activity",
      "title": "Highlighted venue"
     },
     {
      "field": "b",
      "title": "2021-22 (%)",
      "format": ".1f"
     }
    ]
   }
  },
  {
   "mark": {
    "type": "text",
    "align": "left",
    "dx": 14,
    "fontSize": 12,
    "fontWeight": "bold"
   },
   "encoding": {
    "x": {
     "field": "a",
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       80
      ]
     }
    },
    "text": {
     "field": "rel",
     "type": "quantitative",
     "format": "+.0%"
    },
    "color": {
     "condition": {
      "test": "datum.venue_or_activity == 'Libraries'",
      "value": "#1f7a8c"
     },
     "value": "#444"
    }
   }
  }
 ],
 "config": {
  "font": "Open Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Lora",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "Open Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "Open Sans"
  }
 }
}
