{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "Venues adults visited, 2017-18 and 2021-22",
  "subtitle": "Dots show the share of adults who attended; line colour shows how much of the audience was lost"
 },
 "width": "container",
 "height": 330,
 "data": {
  "url": "data/abs_library_attendance.csv"
 },
 "transform": [
  {
   "filter": "datum.breakdown == 'Venue' && datum.population == 'Adults (15+)'"
  },
  {
   "pivot": "year",
   "value": "percent",
   "groupby": [
    "venue_or_activity"
   ]
  },
  {
   "calculate": "datum['2017-18']",
   "as": "a"
  },
  {
   "calculate": "datum['2021-22']",
   "as": "b"
  },
  {
   "calculate": "datum.b / datum.a - 1",
   "as": "rel"
  },
  {
   "calculate": "datum.rel <= -0.45 ? 'Audience fell by about half' : 'Audience fell by about a third'",
   "as": "drop"
  }
 ],
 "encoding": {
  "y": {
   "field": "venue_or_activity",
   "type": "nominal",
   "title": null,
   "sort": {
    "op": "max",
    "field": "rel",
    "order": "descending"
   },
   "axis": {
    "labelLimit": 280,
    "labelFontWeight": {
     "condition": {
      "test": "datum.label == 'Libraries'",
      "value": "bold"
     },
     "value": "normal"
    },
    "labelColor": {
     "condition": {
      "test": "datum.label == 'Libraries'",
      "value": "#0b2f4a"
     },
     "value": "#333"
    },
    "labelFontSize": {
     "condition": {
      "test": "datum.label == 'Libraries'",
      "value": 14
     },
     "value": 12
    }
   }
  }
 },
 "layer": [
  {
   "transform": [
    {
     "filter": "datum.venue_or_activity == 'Libraries'"
    }
   ],
   "mark": {
    "type": "bar",
    "color": "#fff0b3",
    "height": {
     "band": 1
    }
   },
   "encoding": {
    "x": {
     "datum": 0,
     "type": "quantitative"
    },
    "x2": {
     "datum": 80
    }
   }
  },
  {
   "mark": {
    "type": "rule",
    "strokeWidth": 2
   },
   "encoding": {
    "x": {
     "field": "a",
     "type": "quantitative",
     "title": "Percent of adults who attended",
     "scale": {
      "domain": [
       0,
       80
      ]
     }
    },
    "x2": {
     "field": "b"
    },
    "color": {
     "field": "drop",
     "type": "nominal",
     "scale": {
      "domain": [
       "Audience fell by about a third",
       "Audience fell by about half"
      ],
      "range": [
       "#e0a040",
       "#b8680a"
      ]
     },
     "legend": {
      "title": "Change since 2017-18",
      "orient": "top",
      "symbolType": "stroke",
      "symbolStrokeWidth": 2
     }
    },
    "tooltip": [
     {
      "field": "venue_or_activity",
      "title": "Venue"
     },
     {
      "field": "a",
      "title": "2017-18 (%)",
      "format": ".1f"
     },
     {
      "field": "b",
      "title": "2021-22 (%)",
      "format": ".1f"
     },
     {
      "field": "rel",
      "title": "Change in audience",
      "format": "+.0%"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "fold": [
      "a",
      "b"
     ],
     "as": [
      "period",
      "attendance"
     ]
    },
    {
     "calculate": "datum.period == 'a' ? 'Before (2017-18)' : 'After (2021-22)'",
     "as": "period_label"
    }
   ],
   "mark": {
    "type": "point",
    "filled": true,
    "size": 110
   },
   "encoding": {
    "x": {
     "field": "attendance",
     "type": "quantitative"
    },
    "color": {
     "field": "period_label",
     "type": "nominal",
     "scale": {
      "domain": [
       "Before (2017-18)",
       "After (2021-22)"
      ],
      "range": [
       "#999999",
       "#007F86"
      ]
     },
     "legend": {
      "title": "Period",
      "orient": "top"
     }
    },
    "shape": {
     "condition": {
      "test": "datum.venue_or_activity == 'Libraries'",
      "value": "diamond"
     },
     "value": "circle",
     "legend": null
    },
    "tooltip": [
     {
      "field": "venue_or_activity",
      "title": "Venue"
     },
     {
      "field": "period_label",
      "title": "Period"
     },
     {
      "field": "attendance",
      "title": "Attendance (%)",
      "format": ".1f"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "filter": "datum.venue_or_activity == 'Libraries'"
    },
    {
     "calculate": "'Libraries'",
     "as": "highlight"
    }
   ],
   "mark": {
    "type": "point",
    "filled": true,
    "size": 180,
    "color": "#0b2f4a",
    "shape": "diamond",
    "stroke": "#ffffff",
    "strokeWidth": 1.5
   },
   "encoding": {
    "x": {
     "field": "b",
     "type": "quantitative"
    },
    "tooltip": [
     {
      "field": "venue_or_activity",
      "title": "Highlighted venue"
     },
     {
      "field": "b",
      "title": "2021-22 (%)",
      "format": ".1f"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "filter": "datum.venue_or_activity == 'Libraries'"
    },
    {
     "calculate": "'Libraries: ' + format(datum.a,'.0f') + '% to ' + format(datum.b,'.0f') + '%, down a third'",
     "as": "note"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "dx": 14,
    "fontSize": 12,
    "fontWeight": "bold",
    "color": "#0b2f4a"
   },
   "encoding": {
    "x": {
     "field": "a",
     "type": "quantitative"
    },
    "text": {
     "field": "note",
     "type": "nominal"
    }
   }
  }
 ],
 "config": {
  "font": "DM Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Playfair Display",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "DM Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "DM Sans",
   "titleFont": "DM Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "DM Sans",
   "titleFont": "DM Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "DM Sans"
  }
 },
 "resolve": {
  "scale": {
   "color": "independent"
  }
 }
}
