{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "Share of library use that is digital, 2024-25",
  "subtitle": "Click a state to highlight it"
 },
 "width": "container",
 "height": 300,
 "projection": {
  "type": "conicEqualArea",
  "parallels": [
   -18,
   -36
  ],
  "rotate": [
   -132,
   0
  ]
 },
 "layer": [
  {
   "data": {
    "url": "data/australia_states.topojson",
    "format": {
     "type": "topojson",
     "feature": "australia_states"
    }
   },
   "transform": [
    {
     "lookup": "properties.STATE_NAME",
     "from": {
      "data": {
       "url": "data/states.csv"
      },
      "key": "state_name",
      "fields": [
       "state",
       "dig_share"
      ]
     }
    }
   ],
   "params": [
    {
     "name": "sel",
     "select": {
      "type": "point",
      "fields": [
       "state"
      ]
     }
    }
   ],
   "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.2
   },
   "encoding": {
    "color": {
     "field": "dig_share",
     "type": "quantitative",
     "title": "Digital share",
     "scale": {
      "type": "threshold",
      "domain": [
       0.3,
       0.34,
       0.38,
       0.42
      ],
      "range": [
       "#e3f3ea",
       "#b7dfc8",
       "#7ec4a0",
       "#3f9f77",
       "#1f6f4f"
      ]
     },
     "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "format": ".0%",
      "symbolType": "square",
      "symbolSize": 70,
      "labelFontSize": 10,
      "titleFontSize": 10,
      "titleFontWeight": 600,
      "padding": 0,
      "offset": 6,
      "columnPadding": 8,
      "titleAnchor": "start"
     }
    },
    "opacity": {
     "condition": {
      "param": "sel",
      "value": 1
     },
     "value": 0.55
    },
    "tooltip": [
     {
      "field": "properties.STATE_NAME",
      "title": "State"
     },
     {
      "field": "dig_share",
      "title": "Digital share",
      "format": ".1%"
     }
    ]
   }
  },
  {
   "data": {
    "url": "data/australia_states.topojson",
    "format": {
     "type": "topojson",
     "feature": "australia_states"
    }
   },
   "transform": [
    {
     "lookup": "properties.STATE_NAME",
     "from": {
      "data": {
       "url": "data/states.csv"
      },
      "key": "state_name",
      "fields": [
       "state",
       "label_lon",
       "label_lat"
      ]
     }
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 11,
    "fontWeight": "bold",
    "color": "#222"
   },
   "encoding": {
    "longitude": {
     "field": "label_lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "label_lat",
     "type": "quantitative"
    },
    "text": {
     "field": "state"
    }
   }
  }
 ],
 "config": {
  "font": "DM Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Playfair Display",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "DM Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "DM Sans",
   "titleFont": "DM Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "DM Sans",
   "titleFont": "DM Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "DM Sans"
  }
 }
}
