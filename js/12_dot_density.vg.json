{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "Every public library in Australia",
  "subtitle": "One dot = one library, 2016\u20132018"
 },
 "width": "container",
 "height": 380,
 "projection": {
  "type": "conicEqualArea",
  "parallels": [
   -18,
   -36
  ],
  "rotate": [
   -132,
   0
  ]
 },
 "layer": [
  {
   "data": {
    "url": "data/australia_states.topojson",
    "format": {
     "type": "topojson",
     "feature": "australia_states"
    }
   },
   "mark": {
    "type": "geoshape",
    "fill": "#eef2f5",
    "stroke": "#b9c4cc",
    "strokeWidth": 0.8
   }
  },
  {
   "data": {
    "url": "data/library_locations.csv"
   },
   "mark": {
    "type": "circle",
    "size": 9,
    "color": "#4a6072",
    "opacity": 0.6,
    "stroke": "white",
    "strokeWidth": 0.2
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "tooltip": [
     {
      "field": "library",
      "title": "Library"
     },
     {
      "field": "suburb",
      "title": "Suburb"
     },
     {
      "field": "state",
      "title": "State"
     }
    ]
   }
  }
 ],
 "config": {
  "font": "DM Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Playfair Display",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "DM Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "DM Sans",
   "titleFont": "DM Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "DM Sans",
   "titleFont": "DM Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "DM Sans"
  }
 }
}
