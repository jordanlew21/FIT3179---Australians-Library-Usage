{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "Share of library visits made online, 2024-25",
  "subtitle": "Every state is the same size"
 },
 "data": {
  "url": "data/states.csv"
 },
 "width": 300,
 "height": 300,
 "encoding": {
  "x": {
   "field": "tile_col",
   "type": "ordinal",
   "axis": null
  },
  "y": {
   "field": "tile_row",
   "type": "ordinal",
   "axis": null
  }
 },
 "layer": [
  {
   "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 3,
    "cornerRadius": 6
   },
   "encoding": {
    "color": {
     "field": "online_share",
     "type": "quantitative",
     "title": "Online visits",
     "scale": {
      "type": "threshold",
      "domain": [
       0.35,
       0.42,
       0.5,
       0.58
      ],
      "range": [
       "#fbe8d3",
       "#f4c999",
       "#eaa35f",
       "#d97b2c",
       "#a9560f"
      ]
     },
     "legend": {
      "format": ".0%"
     }
    },
    "tooltip": [
     {
      "field": "state_name",
      "title": "State"
     },
     {
      "field": "online_share",
      "title": "Online share of visits",
      "format": ".1%"
     }
    ]
   }
  },
  {
   "mark": {
    "type": "text",
    "fontWeight": "bold",
    "fontSize": 14
   },
   "encoding": {
    "text": {
     "field": "state"
    },
    "color": {
     "condition": {
      "test": "datum.online_share > 0.5",
      "value": "white"
     },
     "value": "#1a1a1a"
    }
   }
  }
 ],
 "config": {
  "font": "Open Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Lora",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "Open Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "Open Sans"
  },
  "scale": {
   "bandPaddingInner": 0,
   "bandPaddingOuter": 0
  }
 }
}