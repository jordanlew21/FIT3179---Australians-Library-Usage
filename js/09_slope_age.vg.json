{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "Adults who went to any cultural venue, by age",
  "subtitle": "Percent of each age group; every group fell between the two surveys"
 },
 "width": "container",
 "height": 360,
 "data": {
  "url": "data/abs_library_attendance.csv"
 },
 "transform": [
  {
   "filter": "datum.breakdown == 'Age group' && datum.venue_or_activity == 'At least one venue or event' && datum.group != 'Total' && datum.population == 'Adults (15+)'"
  }
 ],
 "encoding": {
  "x": {
   "field": "year",
   "type": "ordinal",
   "title": "Year",
   "scale": {
    "padding": 0.9
   },
   "axis": {
    "labelAngle": 0,
    "labelFontSize": 13,
    "labels": true,
    "ticks": true
   }
  },
  "y": {
   "field": "percent",
   "type": "quantitative",
   "title": "Attendance (%)",
   "scale": {
    "domain": [
     30,
     100
    ]
   }
  }
 },
 "layer": [
  {
   "mark": {
    "type": "line",
    "strokeWidth": 2.5
   },
   "encoding": {
    "color": {
     "field": "group",
     "type": "nominal",
     "title": "Age group",
     "scale": {
      "scheme": "viridis"
     },
     "legend": {
      "orient": "right",
      "titleFontSize": 12,
      "labelFontSize": 12,
      "symbolType": "stroke",
      "symbolStrokeWidth": 3
     }
    },
    "detail": {
     "field": "group"
    }
   }
  },
  {
   "mark": {
    "type": "point",
    "filled": true,
    "size": 60
   },
   "encoding": {
    "color": {
     "field": "group",
     "type": "nominal",
     "scale": {
      "scheme": "viridis"
     },
     "legend": null
    },
    "tooltip": [
     {
      "field": "group",
      "title": "Age"
     },
     {
      "field": "year"
     },
     {
      "field": "percent",
      "title": "Attendance (%)",
      "format": ".0f"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "window": [
      {
       "op": "row_number",
       "as": "year_order"
      }
     ],
     "sort": [
      {
       "field": "year",
       "order": "ascending"
      }
     ],
     "groupby": [
      "group"
     ]
    },
    {
     "filter": "datum.year_order == 1"
    }
   ],
   "mark": {
    "type": "text",
    "align": "right",
    "baseline": "middle",
    "dx": -8,
    "fontSize": 11,
    "color": "#333"
   },
   "encoding": {
    "text": {
     "field": "percent",
     "type": "quantitative",
     "format": ".0f"
    }
   }
  },
  {
   "transform": [
    {
     "window": [
      {
       "op": "row_number",
       "as": "year_order"
      }
     ],
     "sort": [
      {
       "field": "year",
       "order": "descending"
      }
     ],
     "groupby": [
      "group"
     ]
    },
    {
     "filter": "datum.year_order == 1"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "baseline": "middle",
    "dx": 8,
    "fontSize": 11,
    "color": "#333"
   },
   "encoding": {
    "text": {
     "field": "percent",
     "type": "quantitative",
     "format": ".0f"
    }
   }
  }
 ],
 "resolve": {
  "scale": {
   "color": "shared"
  }
 },
 "config": {
  "font": "Open Sans",
  "view": {
   "stroke": null
  },
  "title": {
   "font": "Lora",
   "fontSize": 17,
   "fontWeight": 600,
   "anchor": "start",
   "offset": 12,
   "subtitleFont": "Open Sans",
   "subtitleFontSize": 13,
   "subtitleColor": "#555",
   "subtitlePadding": 4
  },
  "axis": {
   "labelFont": "Open Sans",
   "titleFont": "Open Sans",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600,
   "domainColor": "#bbb",
   "tickColor": "#bbb",
   "gridColor": "#eee",
   "labelColor": "#333"
  },
  "legend": {
   "labelFont": "Open Sans",
   "titleFont": "Lora",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 600
  },
  "text": {
   "font": "Open Sans"
  }
 }
}
